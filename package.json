{
  "name": "gradient-dissent",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive critical review and reproducible experiments for arXiv:2609.05275",
  "scripts": {
    "build": "python3 scripts/build_report.py && node scripts/render_math.cjs",
    "build:depth": "python3 scripts/build_depth_report.py",
    "build:a100": "python3 scripts/build_a100_report.py",
    "check": "node --check docs/app.js && node scripts/check_site.cjs",
    "check:depth": "node --check docs/depth-robustness/app.js && node scripts/check_depth_report.cjs",
    "check:a100": "node --check docs/a100-transfer/app.js && node scripts/check_a100_report.cjs",
    "serve": "python3 -m http.server 8765 --directory docs",
    "build:significance": "python3 scripts/build_significance.py",
    "check:significance": "node --check docs/significance/app.js && node scripts/check_significance.cjs",
    "build:paper": "python3 scripts/build_paper.py",
    "check:transcript": "node --check docs/transcripts/research-session/transcript.js && node scripts/check_session_transcript.cjs",
    "check:dropout": "node --check docs/dropout-animation/app.js && node scripts/check_dropout_animation.cjs",
    "build:history": "python3 scripts/build_stochastic_depth_history.py",
    "check:history": "node scripts/check_stochastic_depth_history.cjs",
    "build:ciresan": "python3 scripts/build_ciresan_report.py --final && python3 scripts/build_ciresan_optimization.py",
    "check:ciresan": "node scripts/check_ciresan_report.cjs && node scripts/check_ciresan_optimization.cjs",
    "build:layerdrop": "python3 scripts/build_mnist_layerdrop_report.py",
    "check:layerdrop": "node experiments/ciresan_stochastic_depth/layerdrop_hypotheses/test_page.cjs && node experiments/ciresan_stochastic_depth/layerdrop_hypotheses/test_full_depth_page.cjs",
    "build:halfdrop": "uv run python scripts/build_mnist_halfdrop_report.py",
    "check:halfdrop": "node experiments/ciresan_stochastic_depth/halfdrop/test_page.cjs"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "katex": "^0.18.7"
  }
}
